.DS_Store
.build/
.swiftpm/
*.xcuserdatan
xcuserdata/
DerivedData/

# Screenshots from the launch checks, which CI uploads as a build artifact rather than committing
# — see the macos-screenshots step. One run of scripts/macos-launch-check.sh leaves 7 MB here.
shots/

# Eval artifacts: audio and results are local, case definitions are committed.
eval/results/*
!eval/results/local-real-audio-2026-08-10.json
# Linked from docs/EVALUATION.md, so it has to exist in a fresh clone.
!eval/results/speech-recognition-2026-08-12.json
eval/audio/*.wav
eval/audio/*.flac
eval/audio/*.ogg
eval/audio/*.aiff
# Synthesised by make-audio.sh and asserted on by the speech gate in all three languages, so it
# has to exist in a fresh clone: it is the one-word answer that no tightening of SpeechActivity is
# allowed to drop. See eval/audio/silence/README.md.
!eval/audio/short-word.wav

# The ordinary-dictation corpus is cut from the maintainer's own recordings: the clips are private
# speech and the manifest names the source files and offsets they came from. All of it stays on
# the machine that built it. `eval/build-dictation-corpus.py` rebuilds it from a seed, and only
# aggregate numbers belong in docs/.
eval/dictation/

# Never commit a key.
.env
*.key

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties

# iOS — project.yml is the source of truth; run `xcodegen generate`
ios/DoNotType.xcodeproj/
ios/App/prompt/

# .NET
windows/**/bin/
windows/**/obj/

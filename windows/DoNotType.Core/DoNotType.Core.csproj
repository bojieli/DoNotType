<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately portable (net10.0, no Windows TFM) so the contract logic and its tests build and
    run on any machine, exactly like DoNotTypeCore on the Swift side. Everything Win32 lives in
    DoNotType.App.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The chunker's WAV arithmetic is internal because nothing outside needs it, but it is exactly
    the code most worth testing: a header written wrong corrupts audio silently. Swift's @testable
    covers the same ground on the other side.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="DoNotType.Core.Tests" />
  </ItemGroup>

</Project>

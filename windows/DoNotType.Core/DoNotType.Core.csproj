<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately portable (net10.0, no Windows TFM) so the contract logic and its tests build and
    run on any machine, exactly like DoNotTypeCore on the Swift side. Everything Win32 lives in
    DoNotType.App.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- App and CLI publish for win-x64 and pass that RID through this project reference. Declaring
         it here lets one committed lock file cover both portable tests and the release graph. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The Opus decode loop passes packet and PCM pointers straight to libopus; copying through
         a managed array per 20 ms frame would be pure overhead on the one path that runs per
         frame of a forty-minute recording. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The chunker's WAV arithmetic is internal because nothing outside needs it, but it is exactly
    the code most worth testing: a header written wrong corrupts audio silently. Swift's @testable
    covers the same ground on the other side.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="DoNotType.Core.Tests" />
    <!--
      The CLI builds a quarter-second of silence for `doctor` with `probe`, which needs the same
      WAV header the chunker writes. Sharing the one implementation beats a second copy that could
      drift from what the decoder expects; making it public would put a header-writing helper in
      the surface of a transcription library for the sake of one call.
    -->
    <!-- The CLI's assembly name, not its project name: this attribute matches the former. -->
    <InternalsVisibleTo Include="dnt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Silero's official ONNX model is embedded so a single-file Windows release cannot leave
         its speech gate behind. Swift and Android consume this same checked-in byte sequence. -->
    <EmbeddedResource Include="..\..\Sources\DoNotTypeCore\Resources\silero_vad.onnx"
                      LogicalName="DoNotType.Core.silero_vad.onnx" />
    <EmbeddedResource Include="..\..\Sources\DoNotTypeCore\Resources\SILERO-VAD-NOTICE.txt"
                      LogicalName="DoNotType.Core.SILERO-VAD-NOTICE.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.2" />
  </ItemGroup>

</Project>

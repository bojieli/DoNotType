<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Keep the reviewed lock graph valid for both ordinary builds and the release publish. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UI Automation for grounding lives in the WindowsDesktop WPF assemblies. -->
    <UseWPF>true</UseWPF>
    <!-- Lets the Windows target compile on a non-Windows machine, so CI is not Windows-only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Required by the LibraryImport source generator used for the Win32 entry points. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DoNotType</AssemblyName>
    <RootNamespace>DoNotType.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DoNotType.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoNotType.Core\DoNotType.Core.csproj" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WinForms implicit-usings set omits these two, unlike the default one. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same contract macOS, Android and iOS ship. Copied, never duplicated. The link keeps
         the directory layout, because a part is found by its path under prompt/. -->
    <None Include="..\..\prompt\**\*.md" Link="prompt\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The binary distribution must carry the grant under which it is distributed. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <!-- And the credits for the open-source software it ships, same obligation. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon above gives the .exe its icon in Explorer; embedding the same file lets
         AppIcon.cs read it back at runtime for the tray and the settings window. -->
    <EmbeddedResource Include="Assets\DoNotType.ico" LogicalName="DoNotType.ico" />
  </ItemGroup>

</Project>

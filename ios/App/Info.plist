<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>DoNotType</string>
	<key>CFBundleName</key>
	<string>DoNotType</string>
	<!--
	  A hand-written Info.plist gets nothing synthesised for it: Xcode only fills these in for
	  targets that let it generate the whole file. Without the identifier the build still succeeds
	  and still produces a bundle, but nothing will install it ("Missing bundle ID"); without the
	  executable name installation fails again one step later. `xcodebuild build` never notices,
	  which is why CI was green while the app could not be put on a device.
	-->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>DoNotType records your voice while you dictate and sends it to the model you configured using your own API key.</string>
	<key>NSCameraUsageDescription</key>
	<string>DoNotType uses the camera only while you scan a settings QR code.</string>
</dict>
</plist>

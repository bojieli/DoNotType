<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>DoNotType</string>
	<key>CFBundleName</key>
	<string>DoNotType</string>
	<!--
	  A hand-written Info.plist gets nothing synthesised for it: Xcode only fills these in for
	  targets that let it generate the whole file. Without the identifier the build still succeeds
	  and still produces a bundle, but nothing will install it ("Missing bundle ID"); without the
	  executable name installation fails again one step later. `xcodebuild build` never notices,
	  which is why CI was green while the app could not be put on a device.
	-->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.donottype.dictation</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>donottype</string>
			</array>
		</dict>
	</array>
	<!--
	  `canOpenURL` only answers for third-party schemes declared here. Keep this list aligned with
	  KeyboardHostReturnURL; system Maps does not consume one of iOS's 50 declared-scheme slots.
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>

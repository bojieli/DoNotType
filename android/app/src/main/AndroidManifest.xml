<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      Theme.DoNotType is Material 3; see res/values/themes.xml for what it sets and why. Still
      NoActionBar because the screens draw their own headings - with the action bar the title
      appeared twice, once in a bar the status bar was clipping and once in the content.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoNotType">

        <!--
          What the app opens on. The launcher used to be SettingsActivity, so the first thing
          anybody saw of a dictation app was its configuration; everything that is a setting is now
          one gear away, as it is on iOS.
        -->
        <activity
            android:name=".DictationActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The first launch. Not exported and not a launcher entry: it is reached only from
          DictationActivity, which decides whether it is needed, so there is one place that
          question is answered rather than two that could disagree.
        -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="Set up DoNotType" />

        <!--
          Exported, because the keyboard reaches it: an IME cannot hold an API key or grant itself
          the microphone, so every dead end it has is "go to the app", and it starts this activity
          from its own process with no task of its own.
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name" />

        <!--
          The offline path: a recording that already exists rather than speech into the keyboard.
          Not exported, because it is reached from the settings screen and nothing outside the app
          has business handing it a document to send to a paid API.
        -->
        <activity
            android:name=".FileTranscriptionActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!--
          The record of what the app did: transcripts, failures, and the screen text sent with
          each. Not exported, because it is the user's speech.
        -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="History" />

        <activity
            android:name=".LogsActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".SettingsTransferActivity"
            android:exported="false"
            android:label="Settings transfer" />

        <!--
          The keyboard. Unlike an iOS keyboard extension this may hold RECORD_AUDIO, so the whole
          dictation happens in one process.
        -->
        <service
            android:name=".ime.DoNotTypeIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
          Optional. Grounding is off until the user enables this, and the keyboard works without
          it - it just cannot spell what is on screen.
        -->
        <service
            android:name=".accessibility.ScreenReaderService"
            android:exported="true"
            android:label="@string/accessibility_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Grounding is pull-based: the service subscribes to no event types and collects nothing in the
  background. It reads the node tree only when the keyboard asks, at the moment the user starts
  speaking, so there is no continuous stream of screen contents to retain or leak.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_description"
    android:notificationTimeout="100" />
